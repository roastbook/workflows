{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>michidk/workflows//templates/presets/renovate'],
  packageRules: [
    {
      // scripts/pin-actions.sh pins the composite actions to the last commit that changed
      // them, and the template ref is bumped by hand: a digest bump here would chase every
      // merge to main.
      description: 'Do not manage self-references',
      matchPackageNames: ['Roastbook/workflows'],
      enabled: false,
    },
    {
      // Every copy of a tool pin moves in one pull request. Renovate cannot compute the
      // archive checksums: update each *_SHA256 / *_sha256 next to the version before
      // merging (validate.yml fails until they match).
      description: 'Release binaries installed with a pinned checksum',
      matchPackageNames: ['rhysd/actionlint', 'orhun/git-cliff', 'lycheeverse/lychee', 'michidk/orcastrate'],
      automerge: false,
      prBodyNotes: ['Update the SHA-256 next to every changed version before merging.'],
    },
  ],
  'github-actions': {
    managerFilePatterns: [
      '/(^|/)\\.github/(workflows|actions)/.+\\.ya?ml$/',
      '/^templates/.+\\.yml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'actionlint release binary',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.yml$/'],
      matchStrings: ['ACTIONLINT_VERSION: (?<currentValue>v[0-9.]+)'],
      depNameTemplate: 'rhysd/actionlint',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'lychee release installed by link-check.yml',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.yml$/'],
      matchStrings: [
        'lychee_version:[\\s\\S]*?default: (?<currentValue>lychee-v[0-9.]+)',
        'LYCHEE_VERSION: (?<currentValue>lychee-v[0-9.]+)',
      ],
      depNameTemplate: 'lycheeverse/lychee',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'git-cliff release used by release.yml and the release tests',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.yml$/'],
      matchStrings: [
        'git_cliff_version:[\\s\\S]*?default: (?<currentValue>v[0-9.]+)',
        'GIT_CLIFF_VERSION: (?<currentValue>v[0-9.]+)',
      ],
      depNameTemplate: 'orhun/git-cliff',
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Orcastrate release binary used by sync.yml and validate.yml',
      managerFilePatterns: ['/^\\.github/workflows/.+\\.yml$/'],
      matchStrings: ['ORCASTRATE_VERSION: (?<currentValue>v[0-9.]+)'],
      depNameTemplate: 'michidk/orcastrate',
      datasourceTemplate: 'github-releases',
    },
  ],
}
